{
  "name": "fullburn",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "config",
    "engine"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "leak-check": "node engine/scripts/leak-check.mjs ..",
    "invariants": "vitest run engine/test/invariants",
    "integration": "vitest run engine/test/integration",
    "e2e": "playwright test",
    "mutate": "node engine/scripts/mutate.mjs",
    "done": "node engine/scripts/done.mjs",
    "cross-family-read": "node engine/scripts/cross-family-read.mjs",
    "owed-approvals": "node engine/scripts/owed-approvals.mjs",
    "drill": "vitest run --config vitest.drill.config.ts",
    "test:noisolate": "vitest run --no-isolate --exclude '**/departed-contract.test.ts' --exclude '**/ledger-slot.test.ts'",
    "test:singlefork": "vitest run --pool=forks --poolOptions.forks.singleFork --exclude '**/departed-contract.test.ts' --exclude '**/ledger-slot.test.ts'",
    "test:shuffle": "vitest run --sequence.shuffle --sequence.seed=7 && vitest run --sequence.shuffle --sequence.seed=42 && vitest run --sequence.shuffle --sequence.seed=1234"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.11.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.8"
  }
}
